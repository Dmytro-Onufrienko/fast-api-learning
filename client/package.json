{
  "name": "@learn-fastapi/client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Web app and workspace root for the FastAPI learning platform: textbook, check runner, content and tooling.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit && pnpm -r typecheck",
    "test": "vitest run && pnpm -r --if-present test",
    "validate": "pnpm --filter @learn-fastapi/validate start",
    "check-readme": "pnpm --filter @learn-fastapi/validate check-readme",
    "lint": "echo \"(no linter configured yet)\" && pnpm -r lint"
  },
  "dependencies": {
    "@learn-fastapi/check-engine": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "shiki": "^1.22.2",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.0.1",
    "@types/mdx": "^2.0.13",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vitest": "^2.1.9"
  }
}
